{
  // 対象は Markdown のみ。node_modules は除外する。
  "globs": ["README.md", "skills/**/*.md"],
  "config": {
    // 日本語の本文は折り返さない方針のため、行長は検査しない。
    "MD013": false,
    // 独立した注記を続けて置く書き方をするため、引用ブロック間の空行は許容する。
    "MD028": false,
    // SKILL-template.md が <プレースホルダ> 記法を使う。
    "MD033": { "allowed_elements": ["skill-name"] },
    // セル幅を揃えるのではなく、パイプの前後に空白を1つ置く形で統一する。
    "MD060": { "style": "compact" }
  }
}
